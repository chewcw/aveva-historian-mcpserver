AVEVA_HISTORIAN_BASE_URL=http://historian-server:32569
AVEVA_HISTORIAN_USERNAME=username
AVEVA_HISTORIAN_PASSWORD=secret
AVEVA_HISTORIAN_API_PATH_PREFIX=/Historian/v2
MCP_SERVER_NAME=aveva-historian-mcp
MCP_SERVER_VERSION=0.1.0
LOG_LEVEL=info
LOG_FILE_PATH=log.txt

# MCP Streamable HTTP transport (used when serve --transport http)
MCP_HTTP_BIND=127.0.0.1
MCP_HTTP_PORT=8200
# Required for http transport; min 32 chars. Generate: openssl rand -hex 32
MCP_HTTP_JWT_SECRET=
MCP_HTTP_JWT_ISSUER=aveva-historian-mcp
MCP_HTTP_JWT_AUDIENCE=aveva-historian-mcp
# Path to clients.json (see hashsecret subcommand)
MCP_CLIENTS_FILE=./clients.json
MCP_CORS_ORIGINS=*
MCP_CORS_ALLOW_CREDENTIALS=false
